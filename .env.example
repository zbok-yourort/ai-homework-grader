# 复制本文件为 .env 并填写配置：cp .env.example .env

# ===== AI 配置 =====
# DeepSeek 开放平台申请 API Key：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型名：deepseek-flash 已支持图片输入
#（也可填 deepseek-v4-flash-vision-exp 等旧名，或换成其他 OpenAI 兼容的视觉模型）
AI_MODEL=deepseek-flash

# OpenAI 兼容接口地址；换厂商时改这里即可，例如：
#   智谱 https://open.bigmodel.cn/api/paas/v4
#   通义 https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=https://api.deepseek.com/v1

# 开发 / 演示模式：不调用真实 API，返回模拟批改结果（1 开启，0 关闭）
AI_MOCK=0

# 一次 AI 请求最多携带多少张图（题目裁剪 + 答案页），超出自动分成多批顺序请求
MAX_IMAGES_PER_REQUEST=18

# ===== 服务 =====
# 手机和电脑在同一 Wi-Fi 时，用手机访问 http://<电脑局域网IP>:8000
HOST=0.0.0.0
PORT=8000
